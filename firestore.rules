rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal movie lists: only the owner can read and write
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Reviews: public read; doc ID must be {movieId}_{uid}, so one review per user per movie
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && reviewId == string(request.resource.data.movieId) + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
